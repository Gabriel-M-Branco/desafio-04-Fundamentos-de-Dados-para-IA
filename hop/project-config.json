{
  "metadataBaseFolder": "${PROJECT_HOME}/metadata",
  "unitTestsBasePath": "${PROJECT_HOME}",
  "dataSetsCsvFolder": "${PROJECT_HOME}/datasets",
  "enforcingExecutionInHome": true,
  "config": {
    "variables": [
      {
        "name": "CAMADA_BRONZE",
        "value": "bronze",
        "description": "Schema Bronze"
      },
      {
        "name": "CAMADA_SILVER",
        "value": "silver",
        "description": "Schema Silver"
      },
      {
        "name": "CAMADA_QUARENTENA",
        "value": "quarentena",
        "description": "Schema de quarentena"
      },
      {
