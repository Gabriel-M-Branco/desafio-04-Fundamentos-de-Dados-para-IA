<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>silver_comentarios</name><name_sync_with_filename>Y</name_sync_with_filename>
    <description>Desafio Prático 2 - Estudante 1</description>
    <extended_description>RF20-RF23: Bronze, Silver, workflow, quarentena e recuperação.</extended_description>
    <pipeline_version>1.0</pipeline_version><pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter><name>RUN_ID</name><default_value>manual</default_value><description>Execução Bronze a transformar/reprocessar</description></parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>FIC_DEV</created_user><created_date>2026/09/25 18:00:00.000</created_date>
    <modified_user>FIC_DEV</modified_user><modified_date>2026/09/25 18:00:00.000</modified_date>
  </info>
  <notepads>    <notepad><note>RF21/RF23: válidos seguem para Silver; inválidos, incompletos e duplicados seguem para quarentena com diagnóstico.</note><xloc>64</xloc><yloc>40</yloc><width>850</width><heigth>45</heigth>
      <fontname>Noto Sans</fontname><fontsize>11</fontsize><fontbold>N</fontbold><fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred><fontcolorgreen>58</fontcolorgreen><fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred><backgroundcolorgreen>232</backgroundcolorgreen><backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred><bordercolorgreen>58</bordercolorgreen><bordercolorblue>90</bordercolorblue>
    </notepad></notepads>
  <order>
    <hop><from>Selecionar validos</from><to>Gravar Silver</to><enabled>Y</enabled></hop>
    <hop><from>Selecionar rejeitados</from><to>Gravar Quarentena</to><enabled>Y</enabled></hop>
  </order>
  <transform>
    <name>Selecionar validos</name><type>TableInput</type><description>Seleciona os aprovados da view de classificação.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>PostgreSQL</connection><sql><![CDATA[SELECT comentario_id, usuario_id, conteudo_id, avaliacao, comentario, tags, data, origem, data_hora_ingestao, id_execucao
FROM controle.v_comentarios_classificados
WHERE id_execucao='${RUN_ID}' AND status_registro='VALIDO'
ORDER BY bronze_id]]></sql><limit>0</limit>
    <lookup/><execute_each_row>N</execute_each_row><variables_active>Y</variables_active>
    <attributes/><GUI><xloc>100</xloc><yloc>150</yloc></GUI>
  </transform>
  <transform>
    <name>Gravar Silver</name><type>TableOutput</type><description>Grava em silver.comentarios.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <commit>1000</commit><connection>PostgreSQL</connection>
    <fields>
      <field><column_name>comentario_id</column_name><stream_name>comentario_id</stream_name></field>
      <field><column_name>usuario_id</column_name><stream_name>usuario_id</stream_name></field>
      <field><column_name>conteudo_id</column_name><stream_name>conteudo_id</stream_name></field>
      <field><column_name>avaliacao</column_name><stream_name>avaliacao</stream_name></field>
      <field><column_name>comentario</column_name><stream_name>comentario</stream_name></field>
      <field><column_name>tags</column_name><stream_name>tags</stream_name></field>
      <field><column_name>data</column_name><stream_name>data</stream_name></field>
      <field><column_name>origem</column_name><stream_name>origem</stream_name></field>
      <field><column_name>data_hora_ingestao</column_name><stream_name>data_hora_ingestao</stream_name></field>
      <field><column_name>id_execucao</column_name><stream_name>id_execucao</stream_name></field>
    </fields>
    <return_field/><ignore_errors>N</ignore_errors><partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled><partitioning_field/><partitioning_monthly>N</partitioning_monthly>
    <return_keys>N</return_keys><schema>silver</schema><specify_fields>Y</specify_fields><table>comentarios</table>
    <tablename_field/><tablename_in_field>N</tablename_in_field><tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate><use_batch>Y</use_batch>
    <attributes/><GUI><xloc>450</xloc><yloc>150</yloc></GUI>
  </transform>
  <transform>
    <name>Selecionar rejeitados</name><type>TableInput</type><description>Seleciona rejeitados sem interromper o processamento das demais linhas.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>PostgreSQL</connection><sql><![CDATA[SELECT 'comentarios'::text AS entidade,
  COALESCE(id_registro,bronze_id::text) AS id_registro,
  origem,
  COALESCE(NULLIF(regra_violada,''),'regra não identificada') AS regra_violada,
  COALESCE(NULLIF(mensagem_erro,''),'registro rejeitado') AS mensagem_erro,
  CURRENT_TIMESTAMP AS data_erro,
  id_execucao,
  payload
FROM controle.v_comentarios_classificados
WHERE id_execucao='${RUN_ID}' AND status_registro<>'VALIDO'
ORDER BY bronze_id]]></sql><limit>0</limit>
    <lookup/><execute_each_row>N</execute_each_row><variables_active>Y</variables_active>
    <attributes/><GUI><xloc>100</xloc><yloc>300</yloc></GUI>
  </transform>
  <transform>
    <name>Gravar Quarentena</name><type>TableOutput</type><description>Grava em quarentena.registros.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <commit>1000</commit><connection>PostgreSQL</connection>
    <fields>
      <field><column_name>entidade</column_name><stream_name>entidade</stream_name></field>
      <field><column_name>id_registro</column_name><stream_name>id_registro</stream_name></field>
      <field><column_name>origem</column_name><stream_name>origem</stream_name></field>
      <field><column_name>regra_violada</column_name><stream_name>regra_violada</stream_name></field>
      <field><column_name>mensagem_erro</column_name><stream_name>mensagem_erro</stream_name></field>
      <field><column_name>data_erro</column_name><stream_name>data_erro</stream_name></field>
      <field><column_name>id_execucao</column_name><stream_name>id_execucao</stream_name></field>
      <field><column_name>payload</column_name><stream_name>payload</stream_name></field>
    </fields>
    <return_field/><ignore_errors>N</ignore_errors><partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled><partitioning_field/><partitioning_monthly>N</partitioning_monthly>
    <return_keys>N</return_keys><schema>quarentena</schema><specify_fields>Y</specify_fields><table>registros</table>
    <tablename_field/><tablename_in_field>N</tablename_in_field><tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate><use_batch>Y</use_batch>
    <attributes/><GUI><xloc>450</xloc><yloc>300</yloc></GUI>
  </transform>
  <transform_error_handling></transform_error_handling><attributes/>
</pipeline>
