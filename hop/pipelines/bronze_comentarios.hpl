<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>bronze_comentarios</name><name_sync_with_filename>Y</name_sync_with_filename>
    <description>Desafio Prático 2 - Estudante 1</description>
    <extended_description>RF20-RF23: Bronze, Silver, workflow, quarentena e recuperação.</extended_description>
    <pipeline_version>1.0</pipeline_version><pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter><name>RUN_ID</name><default_value>manual</default_value><description>Identificador único da execução</description></parameter>
      <parameter><name>COMENTARIOS_PATH</name><default_value>${PROJECT_HOME}/../dados/brutos/comentarios.json</default_value><description>Caminho do JSON de comentarios</description></parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>FIC_DEV</created_user><created_date>2026/09/25 18:00:00.000</created_date>
    <modified_user>FIC_DEV</modified_user><modified_date>2026/09/25 18:00:00.000</modified_date>
  </info>
  <notepads>    <notepad><note>RF20: JSON original é pousado na Bronze sem limpeza de regra de negócio; somente auditoria é acrescentada.</note><xloc>64</xloc><yloc>40</yloc><width>850</width><heigth>45</heigth>
      <fontname>Noto Sans</fontname><fontsize>11</fontsize><fontbold>N</fontbold><fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred><fontcolorgreen>58</fontcolorgreen><fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred><backgroundcolorgreen>232</backgroundcolorgreen><backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred><bordercolorgreen>58</bordercolorgreen><bordercolorblue>90</bordercolorblue>
    </notepad></notepads>
  <order>
    <hop><from>Ler comentarios.json</from><to>Adicionar origem</to><enabled>Y</enabled></hop>
    <hop><from>Adicionar origem</from><to>Adicionar id_execucao</to><enabled>Y</enabled></hop>
    <hop><from>Adicionar id_execucao</from><to>Adicionar data_hora_ingestao</to><enabled>Y</enabled></hop>
    <hop><from>Adicionar data_hora_ingestao</from><to>Gravar bronze.comentarios_raw</to><enabled>Y</enabled></hop>
  </order>
  <transform>
    <name>Ler comentarios.json</name><type>JsonInput</type><description>JSON raiz em array; JsonPath repetido gera uma linha por objeto.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <include>N</include><include_field/><rownum>N</rownum><addresultfile>N</addresultfile>
    <readurl>N</readurl><removeSourceField>N</removeSourceField><IsIgnoreEmptyFile>N</IsIgnoreEmptyFile>
    <doNotFailIfNoFile>N</doNotFailIfNoFile><ignoreMissingPath>Y</ignoreMissingPath><defaultPathLeafToNull>Y</defaultPathLeafToNull>
    <rownum_field/><file><name>${COMENTARIOS_PATH}</name><filemask/><exclude_filemask/><file_required>Y</file_required><include_subfolders>N</include_subfolders></file>
    <fields>
      <field><name>usuario_id</name><path>$.*.usuario_id</path><type>String</type><format/><currency/><decimal/><group/>
        <length>-1</length><precision>-1</precision><trim_type>none</trim_type><repeat>Y</repeat></field>
      <field><name>conteudo_id</name><path>$.*.conteudo_id</path><type>String</type><format/><currency/><decimal/><group/>
        <length>-1</length><precision>-1</precision><trim_type>none</trim_type><repeat>Y</repeat></field>
      <field><name>avaliacao</name><path>$.*.avaliacao</path><type>String</type><format/><currency/><decimal/><group/>
        <length>-1</length><precision>-1</precision><trim_type>none</trim_type><repeat>Y</repeat></field>
      <field><name>comentario</name><path>$.*.comentario</path><type>String</type><format/><currency/><decimal/><group/>
        <length>-1</length><precision>-1</precision><trim_type>none</trim_type><repeat>Y</repeat></field>
      <field><name>tags</name><path>$.*.tags</path><type>String</type><format/><currency/><decimal/><group/>
        <length>-1</length><precision>-1</precision><trim_type>none</trim_type><repeat>Y</repeat></field>
      <field><name>data</name><path>$.*.data</path><type>String</type><format/><currency/><decimal/><group/>
        <length>-1</length><precision>-1</precision><trim_type>none</trim_type><repeat>Y</repeat></field>
    </fields>
    <limit>0</limit><IsInFields>N</IsInFields><IsAFile>N</IsAFile><valueField/>
    <shortFileFieldName/><pathFieldName/><hiddenFieldName/><lastModificationTimeFieldName/>
    <uriNameFieldName/><rootUriNameFieldName/><extensionFieldName/><sizeFieldName/>
    <attributes/><GUI><xloc>100</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform>
    <name>Adicionar origem</name><type>Constant</type><description>Auditoria da fonte.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields><field><currency/><decimal/><format/><group/><length>-1</length>
      <name>origem</name><nullif>comentarios.json</nullif><precision>-1</precision><set_empty_string>N</set_empty_string><type>String</type>
    </field></fields>
    <attributes/><GUI><xloc>320</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform>
    <name>Adicionar id_execucao</name><type>GetVariable</type><description>RUN_ID da execução.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields><field><currency/><decimal/><format/><group/><length>-1</length>
      <name>id_execucao</name><precision>-1</precision><trim_type>none</trim_type><type>String</type><variable>${RUN_ID}</variable>
    </field></fields>
    <attributes/><GUI><xloc>520</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform>
    <name>Adicionar data_hora_ingestao</name><type>SystemInfo</type><description>Timestamp fixo da carga.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields><field><name>data_hora_ingestao</name><type>system date (fixed)</type></field></fields>
    <attributes/><GUI><xloc>720</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform>
    <name>Gravar bronze.comentarios_raw</name><type>TableOutput</type><description>Grava em bronze.comentarios_raw.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <commit>1000</commit><connection>PostgreSQL</connection>
    <fields>
      <field><column_name>usuario_id</column_name><stream_name>usuario_id</stream_name></field>
      <field><column_name>conteudo_id</column_name><stream_name>conteudo_id</stream_name></field>
      <field><column_name>avaliacao</column_name><stream_name>avaliacao</stream_name></field>
      <field><column_name>comentario</column_name><stream_name>comentario</stream_name></field>
      <field><column_name>tags</column_name><stream_name>tags</stream_name></field>
      <field><column_name>data</column_name><stream_name>data</stream_name></field>
      <field><column_name>origem</column_name><stream_name>origem</stream_name></field>
      <field><column_name>data_hora_ingestao</column_name><stream_name>data_hora_ingestao</stream_name></field>
      <field><column_name>id_execucao</column_name><stream_name>id_execucao</stream_name></field>
    </fields>
    <return_field/><ignore_errors>N</ignore_errors><partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled><partitioning_field/><partitioning_monthly>N</partitioning_monthly>
    <return_keys>N</return_keys><schema>bronze</schema><specify_fields>Y</specify_fields><table>comentarios_raw</table>
    <tablename_field/><tablename_in_field>N</tablename_in_field><tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate><use_batch>Y</use_batch>
    <attributes/><GUI><xloc>940</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform_error_handling></transform_error_handling><attributes/>
</pipeline>
