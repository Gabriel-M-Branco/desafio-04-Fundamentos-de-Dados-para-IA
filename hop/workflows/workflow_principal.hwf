  <modified_user>-</modified_user>
  <created_date>2026/09/25 21:00:00.000</created_date>
  <modified_date>2026/09/25 21:00:00.000</modified_date>
  <workflow_version/>
  <parameters/>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>8</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>START</name>
      <description>Início do workflow</description>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>16</xloc>
      <yloc>160</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
