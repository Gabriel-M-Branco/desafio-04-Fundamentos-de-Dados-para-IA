<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>workflow_principal</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>RF22 - Orquestração Estudante 1: Bronze -> Silver. Falha interrompe etapa dependente.</description>
  <extended_description/>
