<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>workflow_principal</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>RF22 - Workflow e Orquestração Ponta a Ponta: Bronze -> Silver -> Qualidade -> Gold -> Consumo</description>
  <extended_description>Workflow mestre integrado do Desafio Prático 2. Executa a esteira completa na ordem correta, interrompe etapas dependentes em caso de falha crítica e registra logs com ID de execução.</extended_description>
  <workflow_version>2.0</workflow_version>
  <created_user>FIC_DEV</created_user>
  <created_date>2026/09/25 21:00:00.000</created_date>
  <modified_user>FIC_DEV</modified_user>
  <modified_date>2026/09/28 21:00:00.000</modified_date>
  <parameters>
    <parameter>
      <name>RUN_ID</name>
      <default_value>manual</default_value>
      <description>Identificador único de rastreabilidade da execução</description>
    </parameter>
  </parameters>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>3</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>START</name>
      <description>Início da orquestração automatizada</description>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>60</xloc>
      <yloc>120</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>

    <action>
      <filename>${Internal.Workflow.Filename.Folder}/carga_bronze_silver.hwf</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <run_configuration>local</run_configuration>
      <name>1. Ingestao Bronze e Silver</name>
      <description>RF20 a RF23 - Carga das camadas Bronze e Silver com quarentena de inconsistências</description>
      <type>WORKFLOW</type>
      <attributes/>
      <xloc>260</xloc>
      <yloc>120</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>

    <action>
      <name>2. Criar Estruturas da Camada Gold</name>
      <description>RF26 - Aplicação do DDL analítico e visões para Superset</description>
      <type>SQL</type>
      <attributes/>
      <sql/>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>T</sqlfromfile>
      <sqlfilename>${Internal.Workflow.Filename.Folder}/../../sql/camada_gold.sql</sqlfilename>
      <sendOneStatement>T</sendOneStatement>
      <connection>PostgreSQL</connection>
      <parallel>N</parallel>
      <xloc>520</xloc>
      <yloc>120</yloc>
      <attributes_hac/>
    </action>

    <action>
      <name>3. Registrar Prontidao Silver e Handoff Analitico</name>
      <description>RF22/RF26 - Registra conclusao da ingestao Hop, DDL Gold aplicado e handoff para Parquet/Beam</description>
      <type>SQL</type>
      <attributes/>
      <sql><![CDATA[INSERT INTO controle.execucao_etapa(id_execucao, etapa, inicio, fim, duracao_segundos, resultado, detalhes)
VALUES(
    '${RUN_ID}', 
    'ORQUESTRACAO_HOP', 
    CURRENT_TIMESTAMP, 
    CURRENT_TIMESTAMP, 
    0, 
    'SUCESSO', 
    (SELECT format('catalogo=%s; interacoes=%s; comentarios=%s; quarentena=%s. DDL Gold aplicado com sucesso.',
        (SELECT count(*) FROM silver.catalogo WHERE id_execucao='${RUN_ID}'),
        (SELECT count(*) FROM silver.interacoes WHERE id_execucao='${RUN_ID}'),
        (SELECT count(*) FROM silver.comentarios WHERE id_execucao='${RUN_ID}'),
        (SELECT count(*) FROM quarentena.registros WHERE id_execucao='${RUN_ID}')))
)
ON CONFLICT(id_execucao, etapa) DO UPDATE 
SET fim=CURRENT_TIMESTAMP, resultado='SUCESSO', detalhes=EXCLUDED.detalhes;

UPDATE controle.execucao_workflow
SET fim=CURRENT_TIMESTAMP,
    duracao_segundos=EXTRACT(EPOCH FROM (CURRENT_TIMESTAMP - inicio)),
    resultado=CASE 
        WHEN EXISTS(SELECT 1 FROM quarentena.registros WHERE id_execucao='${RUN_ID}') THEN 'SUCESSO_COM_RESSALVAS' 
        ELSE 'SUCESSO' 
    END,
    detalhes=format('Ingestao Hop e DDL Gold concluidos. Quarentena=%s. Silver homologada para Lakehouse/Beam/Qualidade.', 
        (SELECT count(*) FROM quarentena.registros WHERE id_execucao='${RUN_ID}'))
WHERE id_execucao='${RUN_ID}';]]></sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>PostgreSQL</connection>
      <parallel>N</parallel>
      <xloc>780</xloc>
      <yloc>120</yloc>
      <attributes_hac/>
    </action>

    <action>
      <name>SUCESSO_INTEGRADO</name>
      <description>Fim com sucesso do workflow Apache Hop</description>
      <type>SUCCESS</type>
      <attributes/>
      <xloc>1000</xloc>
      <yloc>120</yloc>
      <attributes_hac/>
    </action>

    <action>
      <name>Compensar e Abortar</name>
      <description>Registra falha crítica em controle e interrompe etapas dependentes</description>
      <type>SQL</type>
      <attributes/>
      <sql><![CDATA[UPDATE controle.execucao_etapa
SET fim=CURRENT_TIMESTAMP,
    duracao_segundos=EXTRACT(EPOCH FROM (CURRENT_TIMESTAMP - inicio)),
    resultado='FALHA',
    detalhes='Interrupção crítica durante o fluxo integrado'
WHERE id_execucao='${RUN_ID}' AND resultado='EM_EXECUCAO';

UPDATE controle.execucao_workflow
SET fim=CURRENT_TIMESTAMP,
    duracao_segundos=EXTRACT(EPOCH FROM (CURRENT_TIMESTAMP - inicio)),
    resultado='FALHA',
    detalhes='Workflow ponta a ponta abortado devido a erro crítico'
WHERE id_execucao='${RUN_ID}';]]></sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>PostgreSQL</connection>
      <parallel>N</parallel>
      <xloc>520</xloc>
      <yloc>280</yloc>
      <attributes_hac/>
    </action>

    <action>
      <name>Log Falha Integrada</name>
      <description>Escreve aviso de falha crítica nos logs do Apache Hop</description>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <logmessage>Falha crítica no Workflow Principal Integrado. Consulte as mensagens anteriores e logs do PostgreSQL.</logmessage>
      <loglevel>Error</loglevel>
      <logsubject>RF22_FALHA_WORKFLOW</logsubject>
      <parallel>N</parallel>
      <xloc>740</xloc>
      <yloc>280</yloc>
      <attributes_hac/>
    </action>

    <action>
      <name>ABORT</name>
      <description>Interrupção forçada por erro crítico</description>
      <type>ABORT</type>
      <attributes/>
      <message>Workflow Principal Abortado.</message>
      <parallel>N</parallel>
      <xloc>960</xloc>
      <yloc>280</yloc>
      <attributes_hac/>
    </action>
  </actions>

  <hops>
    <hop>
      <from>START</from>
      <to>1. Ingestao Bronze e Silver</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>1. Ingestao Bronze e Silver</from>
      <to>2. Criar Estruturas da Camada Gold</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>2. Criar Estruturas da Camada Gold</from>
      <to>3. Registrar Prontidao Silver e Handoff Analitico</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>3. Registrar Prontidao Silver e Handoff Analitico</from>
      <to>SUCESSO_INTEGRADO</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>

    <!-- Hops de Falha Crítica -->
    <hop>
      <from>1. Ingestao Bronze e Silver</from>
      <to>Compensar e Abortar</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>2. Criar Estruturas da Camada Gold</from>
      <to>Compensar e Abortar</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>3. Registrar Prontidao Silver e Handoff Analitico</from>
      <to>Compensar e Abortar</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Compensar e Abortar</from>
      <to>Log Falha Integrada</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Log Falha Integrada</from>
      <to>ABORT</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>

  <notepads>
    <notepad>
      <note>RF22 - ORQUESTRAÇÃO DE INGESTÃO E GOVERNANÇA (Apache Hop)
1. Ingestão Bronze &amp; Silver (arquivos brutos -> bronze -> tipagem/validação silver -> quarentena)
2. Aplicação do DDL analítico e visões da Camada Gold (sql/camada_gold.sql)
3. Auditoria corporativa e Handoff para o Lakehouse (Parquet + Quality Gate + Apache Beam)
4. Falha crítica interrompe etapas dependentes e aciona compensação automática.</note>
      <xloc>60</xloc>
      <yloc>20</yloc>
      <width>750</width>
      <heigth>80</heigth>
      <fontname>Noto Sans</fontname>
      <fontsize>10</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
    </notepad>
  </notepads>
  <attributes/>
</workflow>
